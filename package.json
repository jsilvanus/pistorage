{
  "name": "pistorage",
  "version": "0.1.0",
  "private": true,
  "description": "Durable file storage for the Pi ecosystem: an S3-compatible backend behind a read-through disk cache.",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi --input openapi/openapi.yaml --output src/generated --client fetch && node scripts/fix-generated-imports.mjs",
    "prebuild": "pnpm run generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "cli": "node dist/cli-main.js",
    "pistorage": "node dist/cli-main.js",
    "migrate": "node dist/migrate-main.js"
  },
  "bin": {
    "pistorage": "dist/cli-main.js",
    "pistorage-migrate": "dist/migrate-main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "pi": {
    "service": "pistorage",
    "layer": "Storage",
    "displayName": "PiStorage",
    "port": 3700,
    "healthEndpoint": "/health",
    "envPortVar": "PISTORAGE_PORT"
  }
}
